{
  "dur": {
    "$type": "duration",
    "micro": { "$value": "120ms" },
    "minor": { "$value": "220ms" },
    "major": { "$value": "420ms" },
    "exit": {
      "$value": "165ms",
      "$description": "~75% of minor"
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "entrance": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "exit": { "$value": "cubic-bezier(0.7, 0, 0.84, 0)" },
    "toggle": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
  }
}
