# InclusivCup — environment variable reference (NAMES ONLY — no real values here).
#
# Copy to .env.local and fill with REAL values. .env.local is gitignored.
# NEVER commit real values. Real secrets live ONLY in provider env vars
# (Vercel / Railway) + your gitignored .env.local (AD-25).
#
# Rule: anything secret is server-only and MUST NOT be prefixed NEXT_PUBLIC_.
# The ONLY client-exposed Supabase values are the project URL + anon key.

# ── Client-safe (browser-exposed) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase, server-only (Vercel + Railway) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Sessions are signed with asymmetric ES256 — verify via JWKS at
#   $SUPABASE_URL/auth/v1/.well-known/jwks.json  (no shared secret needed).
# The legacy HS256 secret below is only needed if Epic 2 opts into HS256 verification:
SUPABASE_JWT_SECRET=
# Direct Postgres password (used by migrations in Story 1.2+ and direct worker DB access):
SUPABASE_DB_PASSWORD=

# ── Steam OpenID, server-only — FINALIZED IN STORY 2.1 ────────────────────────
# (needs the deployed domain + a Steam Web API key; placeholders until then)
STEAM_API_KEY=
STEAM_REALM=
STEAM_RETURN_URL=
# HMAC secret that signs the CSRF nonce cookie for the OpenID 2.0 login (Story 2.1).
# OpenID 2.0 has no native state/nonce; this closes that gap. Generate a random 32+ byte
# hex string, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_NONCE_SECRET=

# ── Admin allowlist, server-only — Story 2.2 role bootstrap ───────────────────
# Comma-separated list of 17-digit SteamID64s seeded as `admin` on FIRST login.
# Everyone not listed defaults to `viewer` (fail-closed). Server-only — NEVER
# NEXT_PUBLIC_. Example:  ADMIN_STEAMIDS=76561198000000000,76561198000000001
# NOTE: one-time BOOTSTRAP only — consulted just once, when a player has no app_role
# row yet. Adding an id here AFTER that player's first login does NOT promote them
# (app_role is authoritative so revokes stay durable); post-first-login promotion is
# the Story 2.4 admin grant route.
ADMIN_STEAMIDS=

# ── Cloudflare R2 (S3-compatible), server-only (Railway worker) ───────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_S3_ENDPOINT=

# ── Worker ↔ MatchZy shared secret, server-only (Railway) ─────────────────────
WORKER_MATCHZY_SHARED_SECRET=
